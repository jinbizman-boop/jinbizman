{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jinbiz-management",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/admin/*"
    ]
  },
  "vars": {
    "APP_BASE_URL": "https://www.jinbizman.com",
    "ADMIN_ALLOWED_ORIGINS": "https://www.jinbizman.com,https://jinbizman.com",
    "APP_ENV": "production",
    "SESSION_TTL_SECONDS": "3600",
    "PUBLIC_RATE_LIMIT_PER_10_MIN": "20",
    "LOGIN_RATE_LIMIT_PER_10_MIN": "10",
    "INQUIRY_NOTIFY_TO": "jinbizman@gmail.com",
    "INQUIRY_EMAIL_FROM": "JINBIZ MANAGEMENT <no-reply@jinbizman.com>"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
